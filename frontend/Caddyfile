# Статика SPA внутри контейнера web (без TLS: TLS терминирует proxy)
{
	admin off
	auto_https off
}
:8080 {
	root * /srv
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# маршруты SPA (/app, /company, /admin...) -> index.html; реальные файлы и /api-docs/ отдаются как есть
	@spa {
		not path /api-docs/* /assets/*
		not file
	}
	rewrite @spa /index.html
	redir /api-docs /api-docs/ 308
	file_server
}
