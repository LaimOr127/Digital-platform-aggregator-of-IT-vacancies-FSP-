{
  "name": "itmatch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-api-docs.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript http://localhost:8088/api/openapi.json -o src/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "swagger-ui-dist": "^5.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
