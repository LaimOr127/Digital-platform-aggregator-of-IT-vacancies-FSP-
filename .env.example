# Шаблон окружения. Реальный .env создаётся командой `make env` (случайные секреты) и НЕ коммитится.
APP_ENV=dev
LOG_LEVEL=INFO

# База данных
DB_NAME=itmatch
DB_OWNER_USER=itmatch_owner
DB_OWNER_PASSWORD=
APP_DB_USER=itmatch_app
APP_DB_PASSWORD=

# Приложение
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FSP_BASE_URL=http://fsp-mock:8001
FSP_API_KEY=
# Только dev с моком: показывать код подтверждения ФСП в интерфейсе.
# make prod его игнорирует (выключено); демо-стенд на сервере: FSP_DEMO_CODES_PROD=true
FSP_DEMO_CODES=true
PASSPORT_SIGNING_KEY=

# Языковые модели подключаются в интерфейсе: Админка -> ИИ (любой OpenAI-совместимый API
# или Anthropic). Ключ ниже — запасной вариант, если в интерфейсе модель не выбрана.
# Текст резюме уходит в модель только с согласия кандидата и без контактов.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Почта. Локально письма ловит Mailpit: http://localhost:8025 (MAIL_UI_PORT).
# На сервере: SMTP вашего почтового сервиса и адрес сайта для ссылок в письмах.
PUBLIC_URL=http://localhost:8088
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# пусто — "IT Match <no-reply@itmatch.local>"
SMTP_FROM=
SMTP_STARTTLS=false
MAIL_UI_PORT=8025

# Локальный порт (make dev): http://localhost:8088. Если занят — поменяйте.
HTTP_PORT=8088

# Прокси: локально ":80", на сервере — домен (например example.ru)
SITE_ADDRESS=:80
