# Шаблон окружения. Реальный .env создаётся командой `make env` (случайные секреты) и НЕ коммитится.
APP_ENV=dev
LOG_LEVEL=INFO

# База данных
DB_NAME=itmatch
DB_OWNER_USER=itmatch_owner
DB_OWNER_PASSWORD=
APP_DB_USER=itmatch_app
APP_DB_PASSWORD=

# Приложение
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FSP_BASE_URL=http://fsp-mock:8001
FSP_API_KEY=
# Только dev с моком: показывать код подтверждения ФСП в интерфейсе. В prod — false.
FSP_DEMO_CODES=true
PASSPORT_SIGNING_KEY=

# Локальный порт (make dev): http://localhost:8088. Если занят — поменяйте.
HTTP_PORT=8088

# Прокси: локально ":80", на сервере — домен (например example.ru)
SITE_ADDRESS=:80
